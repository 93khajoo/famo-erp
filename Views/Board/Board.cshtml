async function deleteCardFromBoard(cardId){
  if(!confirm('کارت حذف شود؟'))return;
  const r=await fetch('/Card/DeleteCard',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({cardId})});
  if(r.ok){document.querySelector(`[data-card-id="${cardId}"]`)?.remove();closeCard();showToast('کارت حذف شد');}
}
async function archiveCardFromBoard(cardId){
  if(!confirm('کارت آرشیو شود؟ بعداً می‌توانید آن را از بخش آرشیو بازگردانید.'))return;
  const r=await fetch('/Card/ArchiveCard',{method:'POST',
    headers:{'Content-Type':'application/json'},body:JSON.stringify({cardId})});
  if(r.ok){
    document.querySelector(`[data-card-id="${cardId}"]`)?.remove();
    closeCard();
    showToast('کارت آرشیو شد 📦');
  } else { alert('خطا در آرشیو کارت'); }
}

