// ── Search & Filter ───────────────────────────────────────
function filterCards(){
  const q=document.getElementById('cardSearch').value.trim().toLowerCase();
  const sort=document.getElementById('sortCards').value;
  const assignee=document.getElementById('filterAssignee').value;
  document.querySelectorAll('.board-list').forEach(list=>{
    const container=list.querySelector('.cards-container');
    if(!container)return;
    const cards=[...container.querySelectorAll('.card-item')];
    cards.forEach(c=>{
      const matchQ=!q||c.dataset.title.includes(q);
      const matchA=!assignee||(c.dataset.assignees||'').split(',').includes(assignee);
      c.style.display=matchQ&&matchA?'':'none';
    });
    if(sort!=='default'){
      const visible=cards.filter(c=>c.style.display!=='none');
      visible.sort((a,b)=>{
        if(sort==='title_asc') return a.dataset.title.localeCompare(b.dataset.title,'fa');
        if(sort==='title_desc') return b.dataset.title.localeCompare(a.dataset.title,'fa');
        if(sort==='created_asc') return parseInt(a.dataset.created)-parseInt(b.dataset.created);
        if(sort==='created_desc') return parseInt(b.dataset.created)-parseInt(a.dataset.created);
        if(sort==='deadline_asc'){const da=parseInt(a.dataset.deadline)||Infinity,db=parseInt(b.dataset.deadline)||Infinity;return da-db;}
        if(sort==='deadline_desc'){const da=parseInt(a.dataset.deadline)||0,db=parseInt(b.dataset.deadline)||0;return db-da;}
        if(sort==='started_asc') return parseInt(a.dataset.started)-parseInt(b.dataset.started);
        return 0;
      });
      visible.forEach(c=>container.appendChild(c));
    }
  });
}
function clearFilters(){
  document.getElementById('cardSearch').value='';
  document.getElementById('sortCards').value='default';
  document.getElementById('filterAssignee').value='';
  filterCards();
}

