<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - فامو برد</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar">
  <div class="navbar-brand"><img src="~/images/logo.png" alt="FAMO" class="nav-logo" onerror="this.style.display='none'" /><span class="brand-text">فامو برد</span></div>
  <div class="navbar-actions">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="notif-wrapper" id="notifWrapper">
          <button class="notif-bell" onclick="toggleNotifPanel()"><i class="fas fa-bell"></i><span class="notif-badge" id="notifBadge" style="display:none">0</span></button>
          <div class="notif-panel" id="notifPanel" style="display:none">
            <div class="notif-panel-header"><span>اعلان‌ها</span><button onclick="markAllRead()" class="notif-mark-all">خواندن همه</button></div>
            <div class="notif-list" id="notifList"><div class="notif-empty"><i class="fas fa-bell-slash"></i><p>اعلانی ندارید</p></div></div>
          </div>
        </div>
        <a href="/Report/Kartabl" class="btn-icon" title="کارتابل — گزارش‌های تصفیه حساب" style="font-size:.9rem"><i class="fas fa-wallet"></i></a>
        <a href="/Profile/Index" class="btn-icon" title="پروفایل من" style="font-size:.9rem"><i class="fas fa-user-circle"></i></a>
        <a href="/Admin/Users" class="btn-icon" title="مدیریت کاربران" style="font-size:.8rem"><i class="fas fa-users-cog"></i></a>
        <form method="post" asp-controller="Account" asp-action="Logout" style="display:inline"><button type="submit" class="btn-nav-logout"><i class="fas fa-sign-out-alt"></i> خروج</button></form>
    }
  </div>
</nav>
<main>@RenderBody()</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/js/persian-datepicker.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css" />
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
@if (User.Identity?.IsAuthenticated == true)
{
<script>
const conn = new signalR.HubConnectionBuilder().withUrl("/boardHub").build();
conn.start().catch(()=>{});
async function loadNotifs(){ try{ const r=await fetch('/Notification/List'); const items=await r.json(); renderNotifs(items); updateBadge(items.filter(n=>!n.isRead).length);}catch(e){} }
function renderNotifs(items){ const l=document.getElementById('notifList'); if(!items.length){l.innerHTML='<div class="notif-empty"><i class="fas fa-bell-slash"></i><p>اعلانی ندارید</p></div>';return;} l.innerHTML=items.map(n=>nHtml(n)).join(''); }
function nHtml(n){ const icons={Deadline:'⏰',Assignment:'📌',Comment:'💬',Invite:'🎉',Info:'ℹ️'}; const t=new Date(n.createdAt).toLocaleTimeString('fa-IR',{hour:'2-digit',minute:'2-digit'}); const action=n.cardId?`onclick="goToProj(${n.id},${n.projectId})"`:(n.projectId?`onclick="goToProj(${n.id},${n.projectId})"`:`onclick="markRead(${n.id})"`); return `<div class="notif-item ${n.isRead?'read':'unread'}" id="notif-${n.id}" ${action}><span style="font-size:1.2rem">${icons[n.type]||'🔔'}</span><div class="notif-body"><p class="notif-msg">${n.message}</p><span class="notif-time">${t}</span></div>${!n.isRead?'<span class="notif-dot"></span>':''}</div>`; }
function updateBadge(c){ const b=document.getElementById('notifBadge'); if(c>0){b.textContent=c>99?'99+':c;b.style.display='flex';}else b.style.display='none'; }
function toggleNotifPanel(){ const p=document.getElementById('notifPanel'); const open=p.style.display!=='none'; p.style.display=open?'none':'block'; if(!open)loadNotifs(); }
async function markAllRead(){ await fetch('/Notification/MarkAllRead',{method:'POST'}); document.querySelectorAll('.notif-item.unread').forEach(el=>{el.classList.replace('unread','read');el.querySelector('.notif-dot')?.remove();}); updateBadge(0); }
async function markRead(id){ await fetch('/Notification/MarkRead',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id})}); document.getElementById(`notif-${id}`)?.classList.replace('unread','read'); updateBadge(document.querySelectorAll('.notif-item.unread').length); }
async function goToProj(nId,projectId){ await markRead(nId); window.location.href=`/Board/Board/${projectId}`; }
document.addEventListener('click',e=>{ const w=document.getElementById('notifWrapper'); if(w&&!w.contains(e.target)) document.getElementById('notifPanel').style.display='none'; });
loadNotifs();
</script>
}
</body>
</html>
