@using FamoBoard.Services
@using FamoBoard.Controllers
@model ReportViewModel
@{
    ViewData["Title"] = "گزارشات";
    int projectId = ViewBag.ProjectId;
    string projectName = ViewBag.ProjectName;
    string fromVal = ViewBag.From ?? "";
    string toVal = ViewBag.To ?? "";
    string activeTab = ViewBag.Tab ?? "summary";
    bool unsettledOnly = ViewBag.UnsettledOnly ?? true;

    var pc = new System.Globalization.PersianCalendar();
    string ToShamsi(DateTime dt) => $"{pc.GetYear(dt)}/{pc.GetMonth(dt):D2}/{pc.GetDayOfMonth(dt):D2}";
    string Fmt(long s) { var h=s/3600; var m=(s%3600)/60; var sec=s%60; return $"{h:D2}:{m:D2}:{sec:D2}"; }

    var dailyJson     = System.Text.Json.JsonSerializer.Serialize(Model.Summary.DailyTrend.Select(d => new { date = ToShamsi(d.Date), secs = d.TotalSeconds }));
    var userNamesJson = System.Text.Json.JsonSerializer.Serialize(Model.UserReport.Select(u => u.UserName).ToList());
    var userSecsJson  = System.Text.Json.JsonSerializer.Serialize(Model.UserReport.Select(u => u.TotalSeconds).ToList());
    var cardNamesJson = System.Text.Json.JsonSerializer.Serialize(Model.CardReport.Take(10).Select(c => c.CardTitle.Length>18?c.CardTitle[..18]+"…":c.CardTitle).ToList());
    var cardSecsJson  = System.Text.Json.JsonSerializer.Serialize(Model.CardReport.Take(10).Select(c => c.TotalSeconds).ToList());
    bool isSM = ViewBag.IsScrumMaster ?? false;
    var cpListForContracts = ViewBag.ClientProjectsForReport as List<FamoBoard.Models.ClientProject> ?? new List<FamoBoard.Models.ClientProject>();
    var salNamesJson  = System.Text.Json.JsonSerializer.Serialize(Model.SalaryReport.Select(s => s.UserName).ToList());
    var salValsJson   = System.Text.Json.JsonSerializer.Serialize(Model.SalaryReport.Select(s => (double)s.TotalSalary).ToList());
    var userDailyJson = System.Text.Json.JsonSerializer.Serialize(
        Model.UserReport.Select(u => new {
            id = u.UserId.Replace("-","_"),
            json = System.Text.Json.JsonSerializer.Serialize(u.DailyBreakdown.Select(d => new { date=ToShamsi(d.Date), secs=d.TotalSeconds }))
        }).ToList());
}

<link rel="stylesheet" href="~/css/report.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css" />

<div class="report-page">
  <div class="report-header">
    <a href="/Board/Board/@projectId" class="btn-back"><i class="fas fa-arrow-right"></i> بازگشت</a>
    <div><h1><i class="fas fa-chart-bar"></i> گزارشات — @projectName</h1></div>
  </div>

  <!-- Filters -->
  <form method="get" action="/Report/Index" class="report-filter-bar" id="reportForm">
    <input type="hidden" name="projectId" value="@projectId" />
    <input type="hidden" name="tab" id="tabInput" value="@activeTab" />
    <input type="hidden" name="unsettledOnly" id="unsettledOnlyInput" value="@unsettledOnly.ToString().ToLower()" />
    <div class="filter-group">
      <label><i class="fas fa-calendar"></i> از تاریخ (شمسی)</label>
      <input type="text" name="from" id="fromDate" value="@fromVal" placeholder="۱۴۰۳/۰۱/۰۱" class="jalali-input" readonly />
    </div>
    <div class="filter-group">
      <label><i class="fas fa-calendar"></i> تا تاریخ (شمسی)</label>
      <input type="text" name="to" id="toDate" value="@toVal" placeholder="۱۴۰۳/۱۲/۲۹" class="jalali-input" readonly />
    </div>
    <button type="submit" class="btn-primary"><i class="fas fa-filter"></i> اعمال</button>
    <a href="/Report/Index?projectId=@projectId" class="btn-secondary">حذف فیلتر</a>
    <div class="quick-date-btns">
      <button type="button" onclick="setRange(7)">۷ روز</button>
      <button type="button" onclick="setRange(30)">۳۰ روز</button>
      <button type="button" onclick="setRange(90)">۳ ماه</button>
      <button type="button" onclick="setThisMonth()">این ماه</button>
    </div>
    <label style="display:flex;align-items:center;gap:6px;font-size:.85rem;cursor:pointer">
      <input type="checkbox" id="unsettledCheck" @(unsettledOnly?"checked":"") onchange="toggleUnsettled(this)" />
      فقط تسفیه‌نشده
    </label>
  </form>

  <!-- KPIs -->
  <div class="kpi-grid">
    <div class="kpi-card teal"><div class="kpi-icon"><i class="fas fa-clock"></i></div><div class="kpi-value">@Fmt(Model.Summary.TotalSeconds)</div><div class="kpi-label">مجموع زمان کار</div></div>
    <div class="kpi-card orange"><div class="kpi-icon"><i class="fas fa-tasks"></i></div><div class="kpi-value">@Model.Summary.TotalCards</div><div class="kpi-label">تعداد کل تسک‌ها</div></div>
    <div class="kpi-card blue"><div class="kpi-icon"><i class="fas fa-users"></i></div><div class="kpi-value">@Model.Summary.ActiveMembers</div><div class="kpi-label">نفرات فعال</div></div>
    <div class="kpi-card green"><div class="kpi-icon"><i class="fas fa-money-bill-wave"></i></div><div class="kpi-value">@Model.SalaryReport.Sum(s=>s.TotalSalary).ToString("N0")</div><div class="kpi-label">خالص حقوق (تومان)</div></div>
  </div>

  <!-- Tabs -->
  <div class="report-tabs">
    <button class="rtab @(activeTab=="summary"?"active":"")" onclick="showTab('summary')"><i class="fas fa-home"></i> خلاصه</button>
    <button class="rtab @(activeTab=="users"?"active":"")" onclick="showTab('users')"><i class="fas fa-user-clock"></i> زمان نفرات</button>
    <button class="rtab @(activeTab=="cards"?"active":"")" onclick="showTab('cards')"><i class="fas fa-th-list"></i> تسک‌ها</button>
    <button class="rtab @(activeTab=="salary"?"active":"")" onclick="showTab('salary')"><i class="fas fa-money-bill-wave"></i> حقوق</button>
    @if(isSM){
    <button class="rtab @(activeTab=="videos"?"active":"")" onclick="showTab('videos')"><i class="fas fa-video"></i> ویدئوها</button>
    <button class="rtab @(activeTab=="contracts"?"active":"")" onclick="showTab('contracts');loadContracts()"><i class="fas fa-file-contract"></i> قراردادها</button>
    }
  </div>

  <!-- TAB: SUMMARY -->
  <div id="tab-summary" class="rtab-content @(activeTab!="summary"?"d-none":"")">
    <div class="charts-grid">
      <div class="chart-card wide"><h3><i class="fas fa-chart-area"></i> روند کار روزانه</h3><canvas id="dailyTrendChart" height="90"></canvas></div>
      <div class="chart-card"><h3><i class="fas fa-chart-pie"></i> سهم زمانی نفرات</h3><canvas id="userPieChart" height="200"></canvas></div>
      <div class="chart-card"><h3><i class="fas fa-chart-bar"></i> زمان‌برترین تسک‌ها</h3><canvas id="topCardsChart" height="200"></canvas></div>
    </div>
  </div>

  <!-- TAB: USERS -->
  <div id="tab-users" class="rtab-content @(activeTab!="users"?"d-none":"")">
    <div class="chart-card" style="margin-bottom:20px"><h3><i class="fas fa-chart-bar"></i> مقایسه زمان کار نفرات</h3><canvas id="userBarChart" height="80"></canvas></div>
    @foreach(var u in Model.UserReport){ var safeId=u.UserId.Replace("-","_");
      <div class="user-report-card">
        <div class="urc-header" onclick="toggleSection('urc-@safeId')">
          <div class="urc-avatar">@u.UserName[0]</div>
          <div class="urc-info"><strong>@u.UserName</strong><span>@u.UserEmail</span></div>
          <div class="urc-stats">
            <div class="urc-stat"><span class="urc-val teal">@Fmt(u.TotalSeconds)</span><span>مجموع زمان</span></div>
            <div class="urc-stat"><span class="urc-val orange">@u.Cards.Count</span><span>تسک</span></div>
          </div>
          <i class="fas fa-chevron-down urc-chevron"></i>
        </div>
        <div id="urc-@safeId" class="urc-body" style="display:none">
          <div class="urc-mini-chart"><canvas id="mini-@safeId" height="60"></canvas></div>
          <table class="report-table">
            <thead><tr><th>عنوان تسک</th><th>توضیحات</th><th>زمان</th><th>درصد</th></tr></thead>
            <tbody>
            @foreach(var c in u.Cards.OrderByDescending(x=>x.TotalSeconds)){
              var pct=u.TotalSeconds>0?Math.Round(c.TotalSeconds*100.0/u.TotalSeconds,1):0;
              <tr><td>@c.CardTitle</td><td style="color:var(--mid);font-size:.82rem;max-width:200px">@(string.IsNullOrEmpty(c.CardDescription)?"—":c.CardDescription)</td><td><span class="time-badge">@Fmt(c.TotalSeconds)</span></td><td><div class="mini-bar"><div style="width:@pct%"></div></div><small>%@pct</small></td></tr>
            }
            </tbody>
          </table>
        </div>
      </div>
    }
    @if(!Model.UserReport.Any()){<div class="empty-report"><i class="fas fa-clock"></i><p>در این بازه زمانی داده‌ای ثبت نشده</p></div>}
  </div>

  <!-- TAB: CARDS -->
  <div id="tab-cards" class="rtab-content @(activeTab!="cards"?"d-none":"")">
    <div class="chart-card" style="margin-bottom:20px"><h3><i class="fas fa-chart-bar"></i> زمان‌برترین تسک‌ها</h3><canvas id="cardBarChart" height="100"></canvas></div>
    <div class="report-table-wrap">
      <table class="report-table">
        <thead><tr><th>تسک</th><th>توضیحات</th><th>لیست</th><th>مجموع زمان</th><th>نفرات</th></tr></thead>
        <tbody>
        @foreach(var c in Model.CardReport){
          <tr>
            <td><strong>@c.CardTitle</strong></td>
            <td style="color:var(--mid);font-size:.82rem;max-width:180px">@(string.IsNullOrEmpty(c.CardDescription)?"—":c.CardDescription)</td>
            <td><span class="list-badge">@c.ListName</span></td>
            <td><span class="time-badge">@Fmt(c.TotalSeconds)</span></td>
            <td><div class="user-chips">@foreach(var u in c.Users){<div class="user-chip"><span class="chip-av">@u.UserName[0]</span><span class="chip-name">@u.UserName</span><span class="chip-time">@Fmt(u.TotalSeconds)</span></div>}</div></td>
          </tr>
        }
        </tbody>
      </table>
    </div>
    @if(!Model.CardReport.Any()){<div class="empty-report"><i class="fas fa-tasks"></i><p>داده‌ای یافت نشد</p></div>}
  </div>

  <!-- TAB: SALARY -->
  <div id="tab-salary" class="rtab-content @(activeTab!="salary"?"d-none":"")">
    <div class="chart-card" style="margin-bottom:20px"><h3><i class="fas fa-chart-bar"></i> مقایسه حقوق (پس از کسر جریمه)</h3><canvas id="salaryBarChart" height="80"></canvas></div>
    <div class="penalty-banner"><i class="fas fa-exclamation-triangle"></i> به ازای هر روز تأخیر از ددلاین، <strong>۵٪</strong> از حقوق ناخالص کسر می‌شود (سقف: ۱۰۰٪).</div>
    <div class="report-table-wrap">
      <table class="report-table salary-table">
        <thead>
          <tr><th>نام</th><th>ساعت</th><th>تسک</th><th>ح.ساعتی</th><th>ح.تسکی</th><th>ناخالص</th><th>تأخیر</th><th>جریمه</th><th>خالص</th>@if(isSM){<th>دستمزد اضافه</th><th>قابل پرداخت</th>}<th>عملیات</th></tr>
        </thead>
        <tbody>
        @foreach(var s in Model.SalaryReport){
          var rowId = s.UserId.Replace("-","_");
          <tr class="@(s.OverdueCardCount>0?"has-penalty-row":"")" onclick="@(s.OverdueCardCount>0||s.CardDetails.Any()?$"toggleSection('det-{rowId}')":"")" style="@(s.OverdueCardCount>0||s.CardDetails.Any()?"cursor:pointer":"")">
            <td>
              <div style="display:flex;align-items:center;gap:8px">
                <div class="avatar-sm">@s.UserName[0]</div>
                <div><div style="font-weight:600">@s.UserName</div>
                  @if(s.LastSettlementDate.HasValue){<div style="font-size:.72rem;color:var(--orange)">آخرین تصفیه: @ToShamsi(s.LastSettlementDate.Value)</div>}
                </div>
              </div>
            </td>
            <td><span class="time-badge">@s.TotalHours h</span></td>
            <td>@s.TotalCards</td>
            <td>@(s.SalaryFromHours>0?s.SalaryFromHours.ToString("N0")+" ت":"—")</td>
            <td>@(s.SalaryFromTasks>0?s.SalaryFromTasks.ToString("N0")+" ت":"—")</td>
            <td><strong>@s.GrossSalary.ToString("N0") ت</strong></td>
            <td>@if(s.OverdueCardCount>0){<span class="overdue-badge">@s.OverdueCardCount کارت <i class="fas fa-chevron-down" style="font-size:.7rem"></i></span>}else{<span class="ontime-badge"><i class="fas fa-check"></i></span>}</td>
            <td>@if(s.PenaltyAmount>0){<span class="penalty-badge">−@s.PenaltyPercent.ToString("N0")٪</span>}else{<text>—</text>}</td>
            <td>@if(s.TotalSalary>0){<span class="salary-badge">@s.TotalSalary.ToString("N0") ت</span>}else{<span style="color:var(--mid)">—</span>}</td>
            @if(isSM){
            <td>
              @if(s.PendingWageAdjustment != 0){
                <span class="salary-badge" style="background:#E8F5E9;color:#2E7D32">+@s.PendingWageAdjustment.ToString("N0") ت</span>
              }else{<span style="color:var(--mid)">—</span>}
              <button class="au-btn edit" style="margin-right:4px" onclick="event.stopPropagation();openWageAdj('@s.UserId','@s.UserName')" title="افزودن دستمزد">
                <i class="fas fa-plus-circle"></i>
              </button>
            </td>
            <td>
              @if(s.FinalPending>0){<span class="salary-badge" style="background:#FFF3E0;color:#E65100">@s.FinalPending.ToString("N0") ت</span>}else{<span style="color:var(--mid)">—</span>}
            </td>
            }
            <td onclick="event.stopPropagation()">
              <button class="au-btn edit" onclick="openSettlement('@s.UserId','@s.UserName')" title="ثبت تصفیه">
                <i class="fas fa-handshake"></i> تصفیه
              </button>
            </td>
          </tr>
          <tr id="det-@rowId" style="display:none">
            <td colspan="@(isSM?"12":"10")">
              <div class="penalty-detail-box">
                <!-- Card breakdown -->
                @if(s.CardDetails.Any()){
                  <strong style="font-size:.85rem;display:block;margin-bottom:10px">جزئیات تسک‌ها — @s.UserName</strong>
                  <table class="report-table" style="margin-bottom:16px">
                    <thead><tr><th>عنوان تسک</th><th>توضیحات</th><th>پروژه مشتری</th><th>مدل</th><th>نرخ</th><th>ایجاد</th><th>شروع</th><th>ددلاین</th></tr></thead>
                    <tbody>
                    @foreach(var cd in s.CardDetails){
                      <tr>
                        <td>@cd.Title</td>
                        <td style="color:var(--mid);font-size:.82rem;max-width:150px">@(string.IsNullOrEmpty(cd.Description)?"—":cd.Description)</td>
                        <td><span class="list-badge" style="background:#E3F2FD;color:#1565C0">@(string.IsNullOrEmpty(cd.ClientProjectName)?"—":cd.ClientProjectName)</span></td>
                        <td><span class="list-badge">@cd.TaskTypeName</span></td>
                        <td>@cd.Rate.ToString("N0") ت</td>
                        <td style="font-size:.8rem">@ToShamsi(cd.CreatedAt)</td>
                        <td style="font-size:.8rem">@(cd.StartedAt.HasValue?ToShamsi(cd.StartedAt.Value):"—")</td>
                        <td style="font-size:.8rem">@(cd.Deadline.HasValue?ToShamsi(cd.Deadline.Value):"—")</td>
                      </tr>
                    }
                    </tbody>
                  </table>
                }
                <!-- Overdue cards -->
                @if(s.OverdueCards.Any()){
                  <strong style="font-size:.85rem;display:block;margin-bottom:10px;color:#C62828">کارت‌های معوقه</strong>
                  <table class="report-table">
                    <thead><tr><th>کارت</th><th>ددلاین</th><th>وضعیت</th><th>تأخیر</th><th>جریمه</th></tr></thead>
                    <tbody>
                    @foreach(var oc in s.OverdueCards){
                      <tr>
                        <td>@oc.CardTitle</td>
                        <td>@ToShamsi(oc.Deadline)</td>
                        <td>@if(oc.IsCompleted){<span class="list-badge" style="background:#E8F5E9;color:#2E7D32">تکمیل (دیرکرد)</span>}else{<span class="list-badge" style="background:#FFEBEE;color:#C62828">معوقه</span>}</td>
                        <td><strong>@oc.LateDays روز</strong></td>
                        <td>%@(oc.LateDays*5)</td>
                      </tr>
                    }
                    </tbody>
                  </table>
                }
                <!-- Settlement history -->
                @if(s.Settlements.Any()){
                  <strong style="font-size:.85rem;display:block;margin:16px 0 10px">تاریخچه تصفیه‌ها</strong>
                  <table class="report-table">
                    <thead><tr><th>تاریخ تصفیه</th><th>مبلغ</th><th>یادداشت</th></tr></thead>
                    <tbody>
                    @foreach(var st in s.Settlements){
                      <tr><td>@ToShamsi(st.SettledAt)</td><td><span class="salary-badge">@st.Amount.ToString("N0") تومان</span></td><td style="color:var(--mid)">@st.Note</td></tr>
                    }
                    </tbody>
                  </table>
                }
                <!-- Wage adjustments history -->
                @if(isSM && s.WageAdjustments.Any()){
                  <strong style="font-size:.85rem;display:block;margin:16px 0 10px;color:#2E7D32">دستمزد دریافت‌نشده / مبالغ اضافه</strong>
                  <table class="report-table">
                    <thead><tr><th>تاریخ ثبت</th><th>مبلغ (تومان)</th><th>توضیح</th><th>حذف</th></tr></thead>
                    <tbody>
                    @foreach(var wa in s.WageAdjustments){
                      <tr>
                        <td>@ToShamsi(wa.CreatedAt)</td>
                        <td><span class="salary-badge" style="background:#E8F5E9;color:#2E7D32">@wa.Amount.ToString("N0")</span></td>
                        <td style="color:var(--mid)">@wa.Note</td>
                        <td><button class="au-btn danger" style="padding:3px 8px;font-size:.75rem" onclick="deleteWageAdj(@wa.Id)"><i class="fas fa-trash"></i></button></td>
                      </tr>
                    }
                    </tbody>
                  </table>
                }
              </div>
            </td>
          </tr>
        }
        </tbody>
        <tfoot>
          <tr class="total-row">
            <td colspan="@(isSM?"9":"9")" style="text-align:left;font-weight:700;padding:12px 14px">جمع کل خالص</td>
            <td style="padding:12px 14px"><span class="salary-badge total">@Model.SalaryReport.Sum(s=>s.TotalSalary).ToString("N0") ت</span></td>
            @if(isSM){
            <td style="padding:12px 14px"><span class="salary-badge" style="background:#E8F5E9;color:#2E7D32">+@Model.SalaryReport.Sum(s=>s.PendingWageAdjustment).ToString("N0") ت</span></td>
            <td style="padding:12px 14px"><span class="salary-badge" style="background:#FFF3E0;color:#E65100">@Model.SalaryReport.Sum(s=>s.FinalPending).ToString("N0") ت</span></td>
            <td></td>
            }
          </tr>
        </tfoot>
      </table>
    </div>
    @if(Model.Members.Any(m=>!m.HourlyRate.HasValue&&!m.TaskRate.HasValue)){<div class="rate-hint"><i class="fas fa-info-circle"></i> نرخ حقوقی اعضا را از پنل اعضا تعریف کنید.</div>}
  </div>
</div>

@if(isSM){
<div id="tab-videos" class="rtab-content @(activeTab!="videos"?"d-none":"")">

  <style>
  .vid-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:20px;background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:12px 16px}
  .vid-search-wrap{position:relative;flex:1;min-width:180px}
  .vid-search-wrap i{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--mid);font-size:.85rem;pointer-events:none}
  #vid-search{width:100%;padding:8px 34px 8px 12px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-size:.88rem;outline:none;transition:border-color .2s}
  #vid-search:focus{border-color:var(--teal)}
  .vid-select{padding:8px 12px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-size:.85rem;background:var(--white);color:var(--dark);outline:none;cursor:pointer;transition:border-color .2s}
  .vid-select:focus{border-color:var(--teal)}
  .vid-toggle-filter{display:flex;align-items:center;gap:7px;font-size:.84rem;cursor:pointer;color:var(--mid);white-space:nowrap;padding:7px 12px;border:1.5px solid var(--border);border-radius:8px;transition:all .2s;user-select:none}
  .vid-toggle-filter:hover{border-color:var(--teal);color:var(--teal)}
  .vid-toggle-filter input{display:none}
  .vid-toggle-filter.active{background:var(--teal-pale);border-color:var(--teal);color:var(--teal);font-weight:600}
  .vid-count-badge{background:var(--teal-pale);color:var(--teal);font-weight:700;font-size:.8rem;padding:4px 12px;border-radius:20px;margin-right:auto;white-space:nowrap}

  .vid-list{display:flex;flex-direction:column;gap:10px}
  .vid-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:16px 18px;display:flex;align-items:center;gap:16px;transition:box-shadow .2s,border-color .2s}
  .vid-card:hover{box-shadow:var(--shadow);border-color:var(--teal-light)}
  .vid-card.is-uploaded{border-right:4px solid #4CAF50}
  .vid-card.not-uploaded{border-right:4px solid var(--border)}

  .vid-upload-toggle{flex-shrink:0;width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;border:2px solid var(--border);background:var(--light);transition:all .2s;position:relative}
  .vid-upload-toggle:hover{border-color:var(--teal-light);background:var(--teal-pale)}
  .vid-upload-toggle.done{background:#E8F5E9;border-color:#4CAF50}
  .vid-upload-toggle i{font-size:1.1rem;color:var(--mid);transition:color .2s}
  .vid-upload-toggle.done i{color:#388E3C}

  .vid-info{flex:1;min-width:0}
