let _vidData = [];

async function loadVideos(){
  const list = document.getElementById('vid-tbody');
  const loading = document.getElementById('vid-loading');
  const empty = document.getElementById('vid-empty');
  if(!list) return;
  loading.style.display='block'; list.style.display='none'; empty.style.display='none';
  try{
    const r = await fetch(`/Report/GetVideoCards?projectId=@projectId`);
    _vidData = await r.json();
    renderVideos();
  }catch(e){ console.error(e); }
  finally{ loading.style.display='none'; }
}

function renderVideos(){
  const list = document.getElementById('vid-tbody');
  const empty = document.getElementById('vid-empty');
  const count = document.getElementById('vid-count');
  const search = document.getElementById('vid-search')?.value.trim().toLowerCase()||'';
  const sortField = document.getElementById('vid-sort-field')?.value||'';
  const sortDir = document.getElementById('vid-sort-dir')?.value||'desc';
  const filterUploaded = document.getElementById('vid-filter-uploaded')?.checked||false;

  // update filter label active state
  const filterLabel = document.getElementById('vid-filter-label');
  if(filterLabel) filterLabel.classList.toggle('active', filterUploaded);

  let data = [..._vidData];
  if(search) data = data.filter(v=>v.title.toLowerCase().includes(search));
  if(filterUploaded) data = data.filter(v=>!v.isUploaded);
  if(sortField){
    data.sort((a,b)=>{
      if(sortField==='scheduledUploadAt'){
        const ad=a[sortField]||'', bd=b[sortField]||'';
        return sortDir==='asc'?ad.localeCompare(bd):bd.localeCompare(ad);
      }
      const av=a[sortField]??-1, bv=b[sortField]??-1;
      return sortDir==='asc'?av-bv:bv-av;
    });
  }
  count.textContent=`${data.length} ویدئو`;
  if(!data.length){ list.style.display='none'; empty.style.display='block'; return; }
  list.style.display='flex'; empty.style.display='none';
  list.innerHTML = data.map(v=>`
    <div class="vid-card ${v.isUploaded?'is-uploaded':'not-uploaded'}">
      <div class="vid-upload-toggle ${v.isUploaded?'done':''}" onclick="toggleUpload(${v.cardId},${!v.isUploaded})" title="${v.isUploaded?'علامت‌گذاری نشده':'علامت‌گذاری آپلود شده'}">
        <i class="fas ${v.isUploaded?'fa-check-circle':'fa-cloud-upload-alt'}"></i>
      </div>
      <div class="vid-info">
        <div class="vid-title">${v.title}</div>
        <div class="vid-meta">
          <span class="vid-type-badge">${v.taskType}</span>
          ${v.clientProjectName?`<span class="vid-project-name"><i class="fas fa-briefcase" style="font-size:.7rem"></i>${v.clientProjectName}</span>`:''}
          ${(v.assignees||[]).length?`<span class="vid-assignee"><i class="fas fa-user" style="font-size:.7rem"></i> ${v.assignees.join('، ')}</span>`:''}
          ${v.scheduledUploadAt?`<span class="vid-date"><i class="fas fa-calendar-alt"></i>${v.scheduledUploadAt}</span>`:''}
        </div>
      </div>
      <div class="vid-stats">
        <div class="vid-stat ${v.views==null?'empty':''}"><span class="vid-stat-val">${v.views!=null?Number(v.views).toLocaleString('fa-IR'):'—'}</span><span class="vid-stat-lbl">بازدید</span></div>
        <div class="vid-stat ${v.likes==null?'empty':''}"><span class="vid-stat-val">${v.likes!=null?Number(v.likes).toLocaleString('fa-IR'):'—'}</span><span class="vid-stat-lbl">لایک</span></div>
        <div class="vid-stat ${v.shares==null?'empty':''}"><span class="vid-stat-val">${v.shares!=null?Number(v.shares).toLocaleString('fa-IR'):'—'}</span><span class="vid-stat-lbl">شیر</span></div>
        <div class="vid-stat ${v.reposts==null?'empty':''}"><span class="vid-stat-val">${v.reposts!=null?Number(v.reposts).toLocaleString('fa-IR'):'—'}</span><span class="vid-stat-lbl">ریپست</span></div>
        <div class="vid-stat ${v.skipRate==null?'empty':''}"><span class="vid-stat-val">${v.skipRate!=null?v.skipRate+'%':'—'}</span><span class="vid-stat-lbl">اسکیپ</span></div>
      </div>
      <button class="vid-edit-btn" onclick="openVideoModal(${v.cardId})" title="ویرایش"><i class="fas fa-pen"></i></button>
    </div>
  `).join('');
}

async function toggleUpload(cardId, isUploaded){
  const v = _vidData.find(x=>x.cardId===cardId);
  if(!v) return;
  v.isUploaded = isUploaded;
  await fetch('/Report/SaveVideoUpload',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({cardId, isUploaded, views:v.views, likes:v.likes, shares:v.shares, reposts:v.reposts, skipRate:v.skipRate, scheduledUploadAt:v.scheduledUploadAt})
  });
  renderVideos();
}

function openVideoModal(cardId){
  const v = _vidData.find(x=>x.cardId===cardId);
  if(!v) return;
  document.getElementById('vm-cardId').value=cardId;
  const cpDisplay=document.getElementById('vm-client-project-display');
  const cpName=document.getElementById('vm-client-project-name');
  if(v.clientProjectName){cpName.textContent=v.clientProjectName;cpDisplay.style.display='block';}
  else{cpDisplay.style.display='none';}
  const dateEl=document.getElementById('vm-date');
  dateEl.value=v.scheduledDate||'';
  dateEl.style.borderColor='var(--border)';
  const hint=document.getElementById('vm-date-hint');
  if(hint){ hint.textContent='فرمت: ۱۴۰۳/۰۷/۲۰'; hint.style.color='var(--mid)'; }
  document.getElementById('vm-time').value=v.scheduledTime||'';
  document.getElementById('vm-views').value=v.views??'';
  document.getElementById('vm-likes').value=v.likes??'';
  document.getElementById('vm-shares').value=v.shares??'';
  document.getElementById('vm-reposts').value=v.reposts??'';
  document.getElementById('vm-skip').value=v.skipRate??'';
  document.getElementById('vm-error').style.display='none';
  const saveBtn=document.getElementById('vm-save-btn');
  saveBtn.disabled=false;
  saveBtn.innerHTML='<i class="fas fa-check"></i> ذخیره';
  document.getElementById('vidModal').classList.add('open');
}

async function saveVideoData(){
  const cardId=parseInt(document.getElementById('vm-cardId').value);
  if(!cardId){ return; }
  const v=_vidData.find(x=>x.cardId===cardId);
  const errEl=document.getElementById('vm-error');
  const saveBtn=document.getElementById('vm-save-btn');
  errEl.style.display='none';
  saveBtn.disabled=true;
  saveBtn.innerHTML='<i class="fas fa-spinner fa-spin"></i> در حال ذخیره...';

  const numVal=(id)=>{ const val=document.getElementById(id).value; return val!==''?parseFloat(val):null; };
  const payload={
    cardId,
    isUploaded: v?.isUploaded??false,
    projectName: null,
    scheduledUploadAt: (()=>{
      const d=document.getElementById('vm-date').value.trim();
      const t=document.getElementById('vm-time').value.trim();
      if(!d) return null;
      // validate format YYYY/MM/DD
      const parts=d.split('/');
      if(parts.length!==3||parts[0].length!==4||parts[1].length!==2||parts[2].length!==2) return null;
      return t ? `${d} ${t}` : `${d} 00:00`;
    })(),
    views: numVal('vm-views'),
    likes: numVal('vm-likes'),
    shares: numVal('vm-shares'),
    reposts: numVal('vm-reposts'),
    skipRate: numVal('vm-skip')
  };
  try{
    const r=await fetch('/Report/SaveVideoUpload',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body:JSON.stringify(payload)
    });
    if(!r.ok){ throw new Error('HTTP '+r.status); }
    const json=await r.json();
    if(json.success){
      // آپدیت موقت داده محلی تا reload کامل نشده
      if(v){
        v.scheduledUploadAt=payload.scheduledUploadAt;
        v.scheduledDate=document.getElementById('vm-date').value.trim()||null;
        v.scheduledTime=document.getElementById('vm-time').value.trim()||null;
      }
      document.getElementById('vidModal').classList.remove('open');
      await loadVideos();
    } else {
      errEl.textContent=json.message||'خطا در ذخیره‌سازی';
      errEl.style.display='block';
    }
  }catch(e){
    errEl.textContent='خطا در اتصال به سرور';
    errEl.style.display='block';
  }finally{
    saveBtn.disabled=false;
    saveBtn.innerHTML='<i class="fas fa-check"></i> ذخیره';
  }
}

// ── تاریخ شمسی — auto-format و validation ───────────────
function vmDateInput(el){
  let v = el.value.replace(/[^0-9/]/g,'');
  // auto-insert slashes
  if(v.length===4 && !v.includes('/')) v = v+'/';
  else if(v.length===7 && v.split('/').length===2) v = v+'/';
  el.value = v;
  const hint = document.getElementById('vm-date-hint');
  const parts = v.split('/');
  const valid = parts.length===3 && parts[0].length===4 && parts[1].length===2 && parts[2].length===2
    && !isNaN(+parts[0]) && +parts[1]>=1 && +parts[1]<=12 && +parts[2]>=1 && +parts[2]<=31;
  el.style.borderColor = v.length===0 ? 'var(--border)' : (valid ? '#4CAF50' : 'var(--border)');
  hint.textContent = v.length===0 ? 'فرمت: ۱۴۰۳/۰۷/۲۰' : (valid ? '✓ تاریخ معتبر' : 'فرمت: ۱۴۰۳/۰۷/۲۰');
  hint.style.color = valid ? '#4CAF50' : 'var(--mid)';
}
function vmDateKey(e, el){
  // allow: digits, slash, backspace, delete, arrows, tab
  if(!/[0-9/]/.test(e.key) && !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) e.preventDefault();
}

