  body.innerHTML='<div style="padding:16px;color:var(--mid);font-size:.85rem"><i class="fas fa-spinner fa-spin"></i> در حال محاسبه...</div>';
  const r = await fetch(`/Report/GetContractReport?contractId=${id}`);
  const d = await r.json();
  body.innerHTML = `
    <div style="padding:14px 18px;background:#f0fafa;border-bottom:1px solid var(--border);font-size:.8rem;color:var(--mid);display:flex;gap:18px;flex-wrap:wrap">
      <span><i class="fas fa-calendar"></i> امروز: ${d.nowJ}</span>
      <span><i class="fas fa-clock"></i> ${d.elapsedMonths} از ${d.totalMonths} ماه گذشته</span>
    </div>
    ${d.items.map(it=>{
      const pct = it.expectedSoFar>0 ? Math.min(100,Math.round(it.uploadedCount/it.expectedSoFar*100)) : 0;
      const warn = it.remaining > 0;
      return `<div style="padding:14px 18px;border-bottom:1px solid var(--border)">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap">
          <strong style="font-size:.88rem">${it.taskTypeName}</strong>
          ${it.note?`<span style="font-size:.75rem;color:var(--mid)">(${it.note})</span>`:''}
          <div style="display:flex;gap:14px;margin-right:auto;font-size:.8rem">
            <span style="color:var(--teal)"><i class="fas fa-check-circle"></i> آپلودشده: <strong>${it.uploadedCount}</strong></span>
            <span><i class="fas fa-calendar-check"></i> هدف ماه جاری: <strong>${it.expectedSoFar}</strong></span>
            <span style="color:var(--mid)"><i class="fas fa-list-ol"></i> کل قرارداد: <strong>${it.totalAllowed}</strong></span>
            ${warn?`<span class="ct-behind"><i class="fas fa-exclamation-triangle"></i> باقی‌مانده: <strong>${it.remaining}</strong></span>`:`<span style="color:#43A047"><i class="fas fa-check"></i> به‌روز</span>`}
          </div>
        </div>
        <div class="ct-progress"><div class="ct-progress-bar${warn?' warn':''}" style="width:${pct}%"></div></div>
        <div style="font-size:.72rem;color:var(--mid);margin-top:3px">${pct}٪ از هدف ماه جاری</div>
        ${it.uploads.length?`
          <div class="ct-upload-list">
            <div style="font-size:.75rem;color:var(--mid);font-weight:600;margin-bottom:4px">محتواهای آپلودشده:</div>
            ${it.uploads.map(u=>`<div class="ct-upload-row"><span>${u.title}</span><span style="color:var(--mid)">${u.uploadedAtJ}</span></div>`).join('')}
          </div>`:''}
      </div>`;
    }).join('')}
  `;
}

function addContractItem(taskTypeId='', countPerMonth='', note=''){
  const list = document.getElementById('ct-items-list');
  const div = document.createElement('div');
  div.className = 'ct-item-row';
  div.innerHTML = `
    <select onchange="">${TASK_TYPES_FOR_CT.map(tt=>`<option value="${tt.id}" ${String(tt.id)===String(taskTypeId)?'selected':''}>${tt.name}</option>`).join('')}</select>
    <input type="number" min="1" placeholder="تعداد" value="${countPerMonth}" />
    <input type="text" placeholder="توضیح اختیاری" value="${note}" />
    <button class="ct-item-del" onclick="this.closest('.ct-item-row').remove()"><i class="fas fa-trash"></i></button>
  `;
  list.appendChild(div);
}

function openContractModal(id){
  document.getElementById('ct-id').value=id;
  document.getElementById('ct-modal-title').textContent = id>0?'ویرایش قرارداد':'قرارداد جدید';
  document.getElementById('ct-items-list').innerHTML='';
  if(id>0){
    const c = _ctData.find(x=>x.id===id);
    if(c){
      document.getElementById('ct-cp').value=c.clientProjectId;
      document.getElementById('ct-start').value=c.startDateJ;
      document.getElementById('ct-end').value=c.endDateJ;
      document.getElementById('ct-desc').value=c.description;
      c.items.forEach(it=>addContractItem(it.taskTypeId,it.countPerMonth,it.note));
    }
  } else {
    document.getElementById('ct-cp').value='';
    document.getElementById('ct-start').value='';
    document.getElementById('ct-end').value='';
    document.getElementById('ct-desc').value='';
    addContractItem();
  }
  document.getElementById('ctModal').classList.add('open');
}

async function saveContract(){
  const id=parseInt(document.getElementById('ct-id').value)||0;
  const clientProjectId=parseInt(document.getElementById('ct-cp').value)||0;
  const startRaw=document.getElementById('ct-start').value.trim();
  const endRaw=document.getElementById('ct-end').value.trim();
  const desc=document.getElementById('ct-desc').value.trim();
  if(!clientProjectId){alert('پروژه مشتری را انتخاب کنید');return;}
  if(!startRaw||!endRaw){alert('تاریخ شروع و پایان را وارد کنید');return;}
  const startDate=shamsiToDate(startRaw), endDate=shamsiToDate(endRaw);
  if(!startDate||!endDate){alert('فرمت تاریخ صحیح نیست (مثال: ۱۴۰۳/۰۱/۰۱)');return;}
  if(startDate >= endDate){alert('تاریخ پایان باید بعد از تاریخ شروع باشد');return;}
  const rows=[...document.getElementById('ct-items-list').querySelectorAll('.ct-item-row')];
  const items=rows.map(row=>{
    const sels=row.querySelectorAll('select,input');
    return{taskTypeId:parseInt(sels[0].value)||0,countPerMonth:parseInt(sels[1].value)||0,note:sels[2].value.trim()||null};
  }).filter(it=>it.taskTypeId>0&&it.countPerMonth>0);
  if(!items.length){alert('حداقل یک آیتم قرارداد اضافه کنید');return;}
  const r=await fetch('/Report/SaveContract',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({id,clientProjectId,startDate,endDate,description:desc||null,items})});
  const d=await r.json();
  if(d.success){document.getElementById('ctModal').classList.remove('open');await loadContracts();}
}

async function deleteContract(id){
  if(!confirm('این قرارداد حذف شود؟'))return;
  await fetch('/Report/DeleteContract',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({itemId:id})});
  await loadContracts();
}
</script>
}
