function shamsiToDate(s){
  if(!s) return null;
  const norm = s.replace(/[۰-۹]/g, d => '0123456789'['۰۱۲۳۴۵۶۷۸۹'.indexOf(d)]);
  const parts = norm.split('/');
  if(parts.length !== 3) return null;
  const jy = parseInt(parts[0]), jm = parseInt(parts[1]), jd = parseInt(parts[2]);
  if(!jy || !jm || !jd || jm<1||jm>12||jd<1||jd>31) return null;

  // تابع تشخیص سال کبیسه شمسی
  function isJLeap(y){ return (((y-474)%2820+474+38)*682%2816) < 682; }

  // مرجع: 1 فروردین 1403 = 20 مارس 2024
  const ref_jy = 1403;
  const ref_ms = Date.UTC(2024, 2, 20); // 2024-03-20

  let totalDays = 0;
  if(jy >= ref_jy){
    for(let y=ref_jy; y<jy; y++) totalDays += isJLeap(y)?366:365;
  } else {
    for(let y=jy; y<ref_jy; y++) totalDays -= isJLeap(y)?366:365;
  }
  for(let i=1; i<jm; i++) totalDays += i<=6 ? 31 : 30;
  totalDays += jd - 1;

  const d = new Date(ref_ms + totalDays * 86400000);
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${String(d.getUTCDate()).padStart(2,'0')}T00:00:00Z`;
}

