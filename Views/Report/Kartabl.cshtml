@using FamoBoard.Models
@using System.Text.Json
@model List<SettlementReport>
@{
    ViewData["Title"] = "کارتابل — گزارش‌های تصفیه حساب";
    var pc = new System.Globalization.PersianCalendar();
    string ToJ(DateTime d){ try{ return $"{pc.GetYear(d)}/{pc.GetMonth(d):D2}/{pc.GetDayOfMonth(d):D2}"; }catch{ return ""; } }
}
<link rel="stylesheet" href="~/css/report.css" />
<style>
.kartabl-page{ max-width:860px; margin:0 auto; padding:24px 16px; direction:rtl; font-family:inherit }
.kartabl-header{ display:flex; align-items:center; gap:12px; margin-bottom:28px }
.kartabl-header h1{ font-size:1.35rem; font-weight:700; color:var(--dark); margin:0 }
.kartabl-header .badge-count{ background:var(--teal); color:#fff; border-radius:20px; padding:2px 10px; font-size:.8rem; font-weight:700 }
.kartabl-empty{ text-align:center; padding:60px 20px; color:var(--mid) }
.kartabl-empty i{ font-size:3rem; margin-bottom:12px; display:block; opacity:.35 }
.sr-card{ background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:0; margin-bottom:14px; overflow:hidden; transition:box-shadow .18s, border-color .18s }
.sr-card:hover{ box-shadow:0 4px 18px rgba(0,0,0,.09); border-color:var(--teal-light) }
.sr-card-head{ display:flex; align-items:center; gap:12px; padding:16px 18px; background:linear-gradient(135deg,#e0f2f1 0%,#f5f5f5 100%); border-bottom:1px solid var(--border) }
.sr-card-head .icon{ width:40px; height:40px; background:var(--teal); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:1rem; flex-shrink:0 }
.sr-card-head .info{ flex:1; min-width:0 }
.sr-card-head .project-name{ font-size:.78rem; color:var(--mid); font-weight:500; margin-bottom:2px }
.sr-card-head .period{ font-size:.88rem; font-weight:600; color:var(--dark) }
.sr-amount{ font-size:1.05rem; font-weight:700; color:var(--teal); white-space:nowrap }
.sr-card-body{ padding:14px 18px; display:flex; align-items:center; justify-content:space-between; gap:12px }
.sr-meta{ font-size:.8rem; color:var(--mid) }
.sr-meta span{ margin-left:14px }
.sr-meta i{ margin-left:4px }
.sr-btn{ display:inline-flex; align-items:center; gap:6px; background:var(--teal-pale); color:var(--teal); border:1px solid var(--teal-light); border-radius:8px; padding:6px 14px; font-size:.82rem; font-weight:600; text-decoration:none; transition:background .15s }
.sr-btn:hover{ background:var(--teal-light) }
</style>

<div class="kartabl-page">
  <div class="kartabl-header">
    <a href="/" style="color:var(--mid);text-decoration:none;font-size:1.1rem"><i class="fas fa-arrow-right"></i></a>
    <h1><i class="fas fa-wallet" style="color:var(--teal)"></i> کارتابل — گزارش‌های تصفیه حساب</h1>
    @if(Model.Any()){
      <span class="badge-count">@Model.Count</span>
    }
  </div>

  @if(!Model.Any()){
    <div class="kartabl-empty">
      <i class="fas fa-file-invoice-dollar"></i>
      <p>هنوز هیچ گزارش تصفیه حسابی برای شما ثبت نشده است.</p>
    </div>
  } else {
    @foreach(var r in Model){
      var data = JsonSerializer.Deserialize<JsonElement>(r.ReportJson);
      var projectName = r.ProjectMember?.Project?.Name ?? "";
      var periodFrom = r.PeriodFrom.Year > 2000 ? ToJ(r.PeriodFrom) : null;
      var periodTo = ToJ(r.PeriodTo);
      var cardCount = 0;
      if(data.TryGetProperty("cards", out var cardsEl)) cardCount = cardsEl.GetArrayLength();
      <div class="sr-card">
        <div class="sr-card-head">
          <div class="icon"><i class="fas fa-file-invoice-dollar"></i></div>
          <div class="info">
            <div class="project-name"><i class="fas fa-project-diagram"></i> @projectName</div>
            <div class="period">
              @if(periodFrom != null){
                <span>از @periodFrom</span>
                <span style="color:var(--mid);font-weight:400;margin:0 6px">تا</span>
              } else {
                <span>از ابتدا تا </span>
              }
              <span>@periodTo</span>
            </div>
          </div>
          <div class="sr-amount">@r.Amount.ToString("N0") <span style="font-size:.7rem;font-weight:500;color:var(--mid)">تومان</span></div>
        </div>
        <div class="sr-card-body">
          <div class="sr-meta">
            <span><i class="fas fa-tasks"></i> @cardCount تسک</span>
            <span><i class="fas fa-calendar-check"></i> @ToJ(r.CreatedAt)</span>
          </div>
          <a href="/Report/KartablReport/@r.Id" class="sr-btn"><i class="fas fa-eye"></i> مشاهده گزارش</a>
        </div>
      </div>
    }
  }
</div>
