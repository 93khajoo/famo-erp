@using FamoBoard.Controllers
@model List<UserAdminRow>
@{
    ViewData["Title"] = "مدیریت کاربران";
    var _pc = new System.Globalization.PersianCalendar();
    string ToSh(DateTime d) => $"{_pc.GetYear(d)}/{_pc.GetMonth(d):D2}/{_pc.GetDayOfMonth(d):D2}";
}

<div class="admin-users-page">
  <div class="au-header">
    <div style="display:flex;align-items:center;gap:12px">
      <a href="/" class="btn-back"><i class="fas fa-arrow-right"></i></a>
      <div>
        <h1><i class="fas fa-users-cog"></i> مدیریت کاربران</h1>
        <p style="color:var(--mid);font-size:.82rem;margin-top:2px">
          <i class="fas fa-shield-alt"></i> فقط مدیر اول سیستم می‌تواند این صفحه را ببیند
        </p>
      </div>
    </div>
    <div class="au-stats">
      <div class="au-stat"><span class="au-stat-val">@Model.Count</span><span>کاربر</span></div>
    </div>
  </div>

  <div class="au-search-bar">
    <i class="fas fa-search" style="color:var(--mid)"></i>
    <input type="text" id="userSearch" placeholder="جستجو بر اساس نام، نام کاربری یا ایمیل..." oninput="filterUsers(this.value)" />
  </div>

  <div class="au-table-wrap">
    <table class="au-table" id="usersTable">
      <thead>
        <tr>
          <th>#</th>
          <th>نام نمایشی</th>
          <th>نام کاربری</th>
          <th>ایمیل</th>
          <th>پروژه‌ها</th>
          <th>تاریخ عضویت</th>
          <th>عملیات</th>
        </tr>
      </thead>
      <tbody id="usersBody">
        @for (int i = 0; i < Model.Count; i++)
        {
          var u = Model[i];
          <tr data-user-id="@u.Id" data-search="@u.DisplayName @u.UserName @u.Email">
            <td style="color:var(--mid);font-size:.8rem">@(i+1)</td>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div class="au-avatar">@(u.DisplayName.Length > 0 ? u.DisplayName[0] : '?')</div>
                <div>
                  <div class="au-display-name" id="dn-@u.Id">@u.DisplayName</div>
                  @if (string.IsNullOrEmpty(u.Email))
                  { <div style="font-size:.75rem;color:var(--mid)">بدون ایمیل</div> }
                </div>
              </div>
            </td>
            <td><span class="au-username" id="un-@u.Id">@u.UserName</span></td>
            <td style="color:var(--mid);font-size:.85rem">@(string.IsNullOrEmpty(u.Email) ? "—" : u.Email)</td>
            <td><span class="au-proj-count">@u.ProjectCount پروژه</span></td>
            <td style="color:var(--mid);font-size:.8rem">@ToSh(u.CreatedAt)</td>
            <td>
              <div style="display:flex;gap:6px;flex-wrap:wrap">
                <button class="au-btn edit" onclick="openEditUser('@u.Id','@u.DisplayName.Replace("'","\\'")', '@u.UserName')" title="ویرایش اطلاعات">
                  <i class="fas fa-pen"></i> ویرایش
                </button>
                <button class="au-btn reset" onclick="openResetPassword('@u.Id','@u.DisplayName.Replace("'","\\'")')" title="ریست رمز عبور">
                  <i class="fas fa-key"></i> ریست رمز
                </button>
                <button class="au-btn delete" onclick="deleteUser('@u.Id','@u.DisplayName.Replace("'","\\'")')" title="حذف کاربر">
                  <i class="fas fa-trash"></i> حذف
                </button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

<!-- Edit User Modal -->
<div id="editUserModal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <div class="modal-header">
      <h3><i class="fas fa-user-edit"></i> ویرایش کاربر</h3>
      <button onclick="closeModal('editUserModal')"><i class="fas fa-times"></i></button>
    </div>
    <input type="hidden" id="editUserId" />
    <div class="form-group">
      <label>نام نمایشی</label>
      <input type="text" id="editDisplayName" />
    </div>
    <div class="form-group">
      <label>نام کاربری (برای ورود)</label>
      <input type="text" id="editUserName" dir="ltr" />
    </div>
    <div id="editUserError" class="au-error" style="display:none"></div>
    <div class="modal-footer">
      <button onclick="closeModal('editUserModal')" class="btn-secondary">انصراف</button>
      <button onclick="saveUserEdit()" class="btn-primary"><i class="fas fa-save"></i> ذخیره</button>
    </div>
  </div>
</div>

<!-- Reset Password Modal -->
<div id="resetPwModal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <div class="modal-header">
      <h3><i class="fas fa-key"></i> ریست رمز عبور</h3>
      <button onclick="closeModal('resetPwModal')"><i class="fas fa-times"></i></button>
    </div>
    <p style="color:var(--mid);margin-bottom:16px;font-size:.9rem">
      رمز عبور جدید برای <strong id="resetUserName"></strong>:
    </p>
    <input type="hidden" id="resetUserId" />
    <div class="form-group">
      <label>رمز عبور جدید</label>
      <div style="position:relative">
        <input type="password" id="newPassword" placeholder="حداقل ۶ کاراکتر" dir="ltr" />
        <button type="button" onclick="togglePwVisibility()" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--mid)">
          <i class="fas fa-eye" id="pwEyeIcon"></i>
        </button>
      </div>
    </div>
    <div class="form-group">
      <label>تکرار رمز جدید</label>
      <input type="password" id="confirmPassword" placeholder="رمز را دوباره وارد کنید" dir="ltr" />
    </div>
    <div id="resetPwError" class="au-error" style="display:none"></div>
    <div class="modal-footer">
      <button onclick="closeModal('resetPwModal')" class="btn-secondary">انصراف</button>
      <button onclick="doResetPassword()" class="btn-primary"><i class="fas fa-key"></i> ریست رمز</button>
    </div>
  </div>
</div>

<style>
.admin-users-page{padding:28px 32px;max-width:1100px;margin:0 auto}
.au-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:16px}
.au-header h1{font-size:1.3rem;color:var(--teal);display:flex;align-items:center;gap:8px}
.au-stats{display:flex;gap:16px}
.au-stat{background:#fff;border-radius:12px;padding:12px 20px;border:1px solid var(--border);text-align:center;box-shadow:var(--shadow)}
.au-stat-val{display:block;font-size:1.8rem;font-weight:800;color:var(--teal)}
.au-stat span:last-child{font-size:.78rem;color:var(--mid)}
.au-search-bar{background:#fff;border-radius:10px;border:1.5px solid var(--border);padding:10px 14px;display:flex;align-items:center;gap:10px;margin-bottom:20px;box-shadow:var(--shadow)}
.au-search-bar input{flex:1;border:none;outline:none;font-family:inherit;font-size:.9rem;background:transparent}
.au-table-wrap{background:#fff;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow)}
.au-table{width:100%;border-collapse:collapse}
.au-table th{background:var(--teal-pale);color:var(--teal);padding:12px 14px;text-align:right;font-weight:700;font-size:.82rem}
.au-table td{padding:12px 14px;border-bottom:1px solid var(--border);vertical-align:middle;font-size:.88rem}
.au-table tr:last-child td{border:none}
.au-table tr:hover td{background:var(--light)}
.au-avatar{width:36px;height:36px;border-radius:50%;background:var(--teal);color:#fff;font-size:.9rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.au-display-name{font-weight:600;color:var(--dark)}
.au-username{background:var(--light);border:1px solid var(--border);padding:2px 8px;border-radius:6px;font-size:.8rem;font-family:monospace;color:var(--mid)}
.au-proj-count{background:var(--teal-pale);color:var(--teal);padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:600}
.au-btn{padding:5px 10px;border-radius:7px;border:1px solid;cursor:pointer;font-family:inherit;font-size:.78rem;font-weight:600;display:inline-flex;align-items:center;gap:5px;transition:all .15s}
.au-btn.edit{background:var(--light);border-color:var(--border);color:var(--mid)}
.au-btn.edit:hover{background:var(--teal-pale);border-color:var(--teal-light);color:var(--teal)}
.au-btn.reset{background:#FFF8E1;border-color:#FFD54F;color:#E65100}
.au-btn.reset:hover{background:#FFD54F;color:#E65100}
.au-btn.delete{background:#FFEBEE;border-color:#FFCDD2;color:#C62828}
.au-btn.delete:hover{background:#C62828;border-color:#C62828;color:#fff}
.au-error{background:#FFEBEE;color:#C62828;border-radius:8px;padding:8px 12px;font-size:.85rem;margin-top:8px}
.au-row-hidden{display:none!important}
</style>

@section Scripts {
<script>
function filterUsers(q) {
    const lower = q.toLowerCase();
    document.querySelectorAll('#usersBody tr').forEach(row => {
        const search = row.dataset.search?.toLowerCase() || '';
        row.classList.toggle('au-row-hidden', !!q && !search.includes(lower));
    });
}

function openEditUser(id, displayName, userName) {
    document.getElementById('editUserId').value = id;
    document.getElementById('editDisplayName').value = displayName;
    document.getElementById('editUserName').value = userName;
    document.getElementById('editUserError').style.display = 'none';
    openModal('editUserModal');
    document.getElementById('editDisplayName').focus();
}

async function saveUserEdit() {
    const userId = document.getElementById('editUserId').value;
    const displayName = document.getElementById('editDisplayName').value.trim();
    const userName = document.getElementById('editUserName').value.trim();
    const errEl = document.getElementById('editUserError');
    errEl.style.display = 'none';

    if (!displayName || !userName) { errEl.textContent = 'همه فیلدها الزامی است'; errEl.style.display = 'block'; return; }

    const r = await fetch('/Admin/UpdateUser', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId, displayName, userName }) });
    const d = await r.json();
    if (d.success) {
        document.getElementById(`dn-${userId}`).textContent = displayName;
        document.getElementById(`un-${userId}`).textContent = userName;
        closeModal('editUserModal');
        showAdminToast('اطلاعات کاربر به‌روز شد ✓');
    } else {
        errEl.textContent = d.message; errEl.style.display = 'block';
    }
}

function openResetPassword(id, name) {
    document.getElementById('resetUserId').value = id;
    document.getElementById('resetUserName').textContent = name;
    document.getElementById('newPassword').value = '';
    document.getElementById('confirmPassword').value = '';
    document.getElementById('resetPwError').style.display = 'none';
    openModal('resetPwModal');
    document.getElementById('newPassword').focus();
}

function togglePwVisibility() {
    const inp = document.getElementById('newPassword');
    const icon = document.getElementById('pwEyeIcon');
    if (inp.type === 'password') { inp.type = 'text'; icon.className = 'fas fa-eye-slash'; }
    else { inp.type = 'password'; icon.className = 'fas fa-eye'; }
}

async function doResetPassword() {
    const userId = document.getElementById('resetUserId').value;
    const newPw = document.getElementById('newPassword').value;
    const confirm = document.getElementById('confirmPassword').value;
    const errEl = document.getElementById('resetPwError');
    errEl.style.display = 'none';

    if (!newPw) { errEl.textContent = 'رمز جدید را وارد کنید'; errEl.style.display = 'block'; return; }
    if (newPw.length < 6) { errEl.textContent = 'رمز باید حداقل ۶ کاراکتر باشد'; errEl.style.display = 'block'; return; }
    if (newPw !== confirm) { errEl.textContent = 'رمز و تکرار آن یکسان نیستند'; errEl.style.display = 'block'; return; }

    const r = await fetch('/Admin/ResetPassword', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId, newPassword: newPw }) });
    const d = await r.json();
    if (d.success) {
        closeModal('resetPwModal');
        showAdminToast('رمز عبور با موفقیت تغییر کرد ✓');
    } else {
        errEl.textContent = d.message; errEl.style.display = 'block';
    }
}

async function deleteUser(id, name) {
    if (!confirm(`کاربر "${name}" حذف شود؟\nاین عمل برگشت‌ناپذیر است.`)) return;
    const r = await fetch('/Admin/DeleteUser', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId: id }) });
    const d = await r.json();
    if (d.success) {
        document.querySelector(`tr[data-user-id="${id}"]`)?.remove();
        showAdminToast('کاربر حذف شد');
    } else {
        alert(d.message);
    }
}

function showAdminToast(msg) {
    const t = document.createElement('div');
    t.className = 'toast-simple';
    t.style.cssText = 'background:var(--teal);';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
}
</script>
}
